PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=metcommerce
JWT_SECRET=cambia-esto-por-una-cadena-aleatoria-larga
JWT_EXPIRES_IN=8h
# URL pública del frontend/admin en producción, para restringir CORS
# (déjala vacía en desarrollo local)
FRONTEND_URL=

# Panel MercadoPago > Tus integraciones > [tu app] > pestaña "Credenciales de
# prueba" (NO "Credenciales de producción"). Ambas empiezan con APP_USR-, la
# diferencia es de qué pestaña las copiaste, no el texto.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Moneda de los items de la preferencia (ISO 4217). Cambia según tu país:
# COP, MXN, ARS, CLP, etc.
MERCADOPAGO_CURRENCY=COP
# URL de la tienda a la que MercadoPago redirige al comprador después de
# pagar. En desarrollo local queda en http://localhost:8080 si la dejas vacía.
URL_TIENDA=http://localhost:8080
# URL pública del backend, para que MercadoPago pueda llamar al webhook de
# pagos. En desarrollo local no hay forma de que te alcance (localhost no es
# accesible desde internet); déjala vacía y usa la confirmación por
# redirección, que sí funciona en local.
BACKEND_URL=
